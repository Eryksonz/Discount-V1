# Database (Neon Postgres provisioned via `neon deploy`)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tape_and_tailor"

# Explicit opt-in for simulated local demo fallback when DATABASE_URL is unset.
# Must be "false" (or omitted) in production — app throws loudly without DATABASE_URL.
DEMO_MODE="false"

# Site identity
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Tape & Tailor"

# Admin panel protection (/admin unclassified & quarantine queues)
ADMIN_PASSWORD="change-me-local-admin"

# Standalone crawler settings
CRAWLER_CONTACT_EMAIL="crawler@tapeandtailor.example.com"
CRAWLER_DEFAULT_RATE_LIMIT_MS="2000"

# Email alerts & crawler drop-off monitoring
RESEND_API_KEY=""
ALERT_FROM_EMAIL="alerts@tapeandtailor.example.com"
ADMIN_ALERT_EMAIL="ops@tapeandtailor.example.com"

# Optional: enables one-click "Crawl Now" in /admin via GitHub Actions workflow_dispatch
GITHUB_TOKEN=""
GITHUB_REPO="Eryksonz/Discount-V1"
